# Dolancer SPA environment.
# Only client-safe values belong here. The Supabase secret key carries BYPASSRLS
# and must never exist in this codebase; it is quarantined to backend edge functions.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# "true" runs the whole app on built-in sample data with no backend, for demos.
# The two values above are then optional. `npm run dev:demo` turns this on for you.
VITE_DEMO_MODE=false
